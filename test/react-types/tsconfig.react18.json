{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "typeRoots": [],
    "baseUrl": ".",
    "paths": {
      "react": ["../../studio/node_modules/@types/react-18"],
      "react/*": ["../../studio/node_modules/@types/react-18/*"]
    }
  },
  "include": ["../../react/*.ts", "../../react/*.tsx"]
}
