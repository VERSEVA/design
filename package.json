{
  "name": "@verseva/design",
  "version": "1.7.0",
  "description": "VERSEVA Design: the signature tokens, component contract, Tailwind bridge, and the four-gate enforcement suite (hex, contrast, spacing, type).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VERSEVA/design.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "npm@10.9.9",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./components.css": "./components.css",
    "./tailwind.css": "./tailwind.css",
    "./preset": "./tailwind.preset.cjs",
    "./react/*": "./react/*.tsx",
    "./react/activity-state": "./react/activity-state.ts",
    "./react/command-state": "./react/command-state.ts",
    "./react/console-state": "./react/console-state.ts",
    "./react/cx": "./react/cx.ts",
    "./react/date-range-state": "./react/date-range-state.ts",
    "./react/inert": "./react/inert.ts",
    "./react/labels": "./react/labels.ts",
    "./react/widget-state": "./react/widget-state.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "verseva": "bin/verseva.mjs",
    "verseva-mcp": "bin/verseva-mcp.mjs",
    "verseva-hex-gate": "bin/hex-gate.mjs",
    "verseva-contrast-gate": "bin/contrast-gate.mjs",
    "verseva-spacing-gate": "bin/spacing-gate.mjs",
    "verseva-type-gate": "bin/type-gate.mjs",
    "verseva-recipe-gate": "bin/recipe-gate.mjs",
    "verseva-gate": "bin/verseva-gate.mjs"
  },
  "files": [
    "tokens.css",
    "components.css",
    "tailwind.css",
    "tailwind.preset.cjs",
    "bin",
    "docs",
    "!docs/media",
    "templates",
    "react",
    "blocks",
    "themes",
    "registry.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run gate",
    "gate": "node bin/verseva-gate.mjs --tokens tokens.css --tokens themes/cobalt.css --tokens themes/forest.css --tokens themes/violet.css --tokens themes/slate.css --allow test --exclude swift . studio/src studio/index.html",
    "studio:build": "npm --prefix studio ci --no-audit --no-fund && npm --prefix studio run build && npm run -s gate:studio",
    "assemble": "node scripts/assemble.mjs",
    "tokens:resolve": "node bin/resolve-tokens.mjs",
    "test:served": "node --test --test-concurrency=1 test/served/*.test.mjs",
    "typecheck": "node studio/node_modules/typescript/bin/tsc --noEmit -p studio/tsconfig.json",
    "gate:studio": "node bin/verseva-gate.mjs --tokens tokens.css --tokens themes/cobalt.css --tokens themes/forest.css --tokens themes/violet.css --tokens themes/slate.css --allow GLTFExporter --exclude swift studio/dist",
    "prepublishOnly": "npm test && npm run gate"
  }
}
