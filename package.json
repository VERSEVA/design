{
  "name": "@verseva/design",
  "version": "1.1.0",
  "description": "VERSEVA Design: the signature tokens, component contract, Tailwind bridge, and the four-gate enforcement suite (hex, contrast, spacing, type).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verseva/design.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./components.css": "./components.css",
    "./tailwind.css": "./tailwind.css",
    "./preset": "./tailwind.preset.cjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "verseva": "bin/verseva.mjs",
    "verseva-mcp": "bin/verseva-mcp.mjs",
    "verseva-hex-gate": "bin/hex-gate.mjs",
    "verseva-contrast-gate": "bin/contrast-gate.mjs",
    "verseva-spacing-gate": "bin/spacing-gate.mjs",
    "verseva-type-gate": "bin/type-gate.mjs",
    "verseva-gate": "bin/verseva-gate.mjs"
  },
  "files": [
    "tokens.css",
    "components.css",
    "tailwind.css",
    "tailwind.preset.cjs",
    "bin",
    "docs",
    "templates",
    "react",
    "blocks",
    "themes",
    "registry.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "gate": "node bin/verseva-gate.mjs --tokens tokens.css --tokens themes/cobalt.css --tokens themes/forest.css --tokens themes/violet.css --tokens themes/slate.css --allow test --allow board .",
    "board": "node board/pull-themes.mjs && python3 -m http.server 4390 --directory ."
  }
}
