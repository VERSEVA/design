  "<div class=\"curve c-standard\"><span class=\"cl\">--ease-standard</span><span class=\"track\"><span class=\"ball\"></span></span></div>\n<div class=\"curve c-entrance\"><span class=\"cl\">--ease-entrance</span><span class=\"track\"><span class=\"ball\"></span></span></div>\n<div class=\"curve c-emph\"><span class=\"cl\">--ease-emph</span><span class=\"track\"><span class=\"ball\"></span></span></div>\n<div class=\"curve c-exit\"><span class=\"cl\">--ease-exit</span><span class=\"track\"><span class=\"ball\"></span></span></div>\n<div class=\"curve c-back\"><span class=\"cl\">--ease-back</span><span class=\"track\"><span class=\"ball\"></span></span></div>\n<div class=\"replaybar\"><button class=\"btn btn-secondary sm\" id=\"firecurves\" type=\"button\">Run the curves</button></div>\n<div class=\"tscroll\">\n  <table class=\"ttable\">\n    <thead><tr><th>Token</th><th>Value</th><th>Job</th></tr></thead>\n    <tbody>\n      <tr><td>--dur-1</td><td>120ms</td><td>Press, hover, color shifts</td></tr>\n      <tr><td>--dur-2</td><td>200ms</td><td>Toggles, switches, chips</td></tr>\n      <tr><td>--dur-3</td><td>320ms</td><td>Entrances, sheets, disclosure</td></tr>\n      <tr><td>--dur-4</td><td>480ms</td><td>Orchestrated moments, rare</td></tr>\n      <tr><td>--ease-standard</td><td>cubic-bezier(.2, 0, 0, 1)</td><td>The default; press and state</td></tr>\n      <tr><td>--ease-entrance</td><td>cubic-bezier(.16, 1, .3, 1)</td><td>Things arriving</td></tr>\n      <tr><td>--ease-emph</td><td>cubic-bezier(.3, 0, .1, 1)</td><td>Emphasis, attention</td></tr>\n      <tr><td>--ease-exit</td><td>cubic-bezier(.3, 0, 1, 1)</td><td>Leaving for good</td></tr>\n      <tr><td>--ease-back</td><td>cubic-bezier(.34, 1.56, .64, 1)</td><td>Snap-back settle after a drag or magnet</td></tr>\n      <tr><td>--ease-spring</td><td>cubic-bezier(.22, 1, .36, 1)</td><td>Playful settle, sparing</td></tr>\n    </tbody>\n  </table>\n</div>",
