{
  "name": "@verseva/design-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tokens-model.mjs && node scripts/chapters-model.mjs && vite",
    "prebuild": "node scripts/tokens-model.mjs && node scripts/chapters-model.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=forks"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "19.2.2",
    "@types/react-18": "npm:@types/react@18.3.31",
    "@types/react-dom": "19.2.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
