{
  "buildCommand": "npm run studio:build && npm run assemble",
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/components.html",
      "destination": "/components",
      "permanent": true
    },
    {
      "source": "/web-ui.html",
      "destination": "/web-ui",
      "permanent": true
    },
    {
      "source": "/data-viz.html",
      "destination": "/data-viz",
      "permanent": true
    },
    {
      "source": "/motion.html",
      "destination": "/motion",
      "permanent": true
    },
    {
      "source": "/decks.html",
      "destination": "/decks",
      "permanent": true
    },
    {
      "source": "/docs-pdf.html",
      "destination": "/docs-pdf",
      "permanent": true
    },
    {
      "source": "/distribute.html",
      "destination": "/distribute",
      "permanent": true
    },
    {
      "source": "/examples.html",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/board/:path*",
      "destination": "/foundations",
      "permanent": true
    },
    {
      "source": "/code.html",
      "has": [
        {
          "type": "query",
          "key": "f",
          "value": "^examples/console\\.html$"
        }
      ],
      "destination": "/gallery/console/code",
      "permanent": true
    },
    {
      "source": "/code.html",
      "has": [
        {
          "type": "query",
          "key": "f",
          "value": "^examples/landing\\.html$"
        }
      ],
      "destination": "/gallery/landing/code",
      "permanent": true
    },
    {
      "source": "/code.html",
