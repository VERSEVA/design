        {
          "type": "query",
          "key": "f",
          "value": "^examples/pulse\\.html$"
        }
      ],
      "destination": "/gallery/pulse/code",
      "permanent": true
    },
    {
      "source": "/code.html",
      "has": [
        {
          "type": "query",
          "key": "f",
          "value": "^examples/quote-tool\\.html$"
