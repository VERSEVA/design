    },
    {
      "source": "/code.html",
      "has": [
        {
          "type": "query",
          "key": "f",
          "value": "^examples/store\\.html$"
        }
      ],
      "destination": "/gallery/store/code",
      "permanent": true
    },
    {
      "source": "/code.html",
      "has": [
        {
          "type": "query",
          "key": "f",
          "value": "^examples/studio\\.html$"
        }
      ],
      "destination": "/gallery/studio/code",
      "permanent": true
    },
    {
      "source": "/code.html",
      "has": [
        {
          "type": "query",
          "key": "f",
          "value": "^examples/three-hero\\.html$"
        }
      ],
      "destination": "/gallery/three-hero/code",
