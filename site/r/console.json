{
  "name": "console",
  "kind": "block",
  "description": "Ops console: sidebar, stats, chart, sortable table, live search",
  "deps": [],
  "files": [
    {
      "path": "console.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VERSEVA Design · Example: ops console</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500..700&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap\">\n<link rel=\"stylesheet\" href=\"../../tokens.css?v=red1\">\n<link rel=\"stylesheet\" href=\"../../components.css?v=red1\">\n<style>\n  * { margin: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); font-size: 15px; line-height: 1.5; }\n  .crumb { position: sticky; top: 0; z-index: 10; background: var(--bg); display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--hairline); font-size: 12.5px; color: var(--text-3); }\n  .crumb a { color: var(--text-2); text-decoration: none; font-family: var(--font-display); font-weight: var(--display-weight); }\n  .crumb .stop { color: var(--accent); }\n  .app { display: grid; grid-template-columns: 232px 1fr; min-height: 92vh; }\n  aside { border-right: 1px solid var(--hairline); padding: var(--s-4); display: grid; gap: var(--s-4); align-content: start; }\n  main { padding: var(--s-5) var(--s-6); display: grid; gap: var(--s-5); align-content: start; }\n  .mainhead { display: flex; align-items: center; gap: var(--s-4); }\n  .mainhead h1 { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 20px; letter-spacing: -0.015em; flex: 1; }\n  .duo { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--s-4); }\n  @media (max-width: 900px) { .app { grid-template-columns: 1fr; } aside { display: none; } .duo { grid-template-columns: 1fr; } }\n  .crumb a { display: inline-flex; align-items: center; gap: 8px; }\n  .crumb .vmark { width: 16px; height: 16px; flex: none; }\n  .crumb .codelink { margin-left: auto; }\n</style>\n</head>\n<body>\n<div class=\"crumb\"><a href=\"../index.html\"><svg class=\"vmark\" viewBox=\"0 0 768 775.92\" aria-hidden=\"true\"><defs><clipPath id=\"vmk-a\"><path d=\"M400 277h358v396.4H400z\"/></clipPath><clipPath id=\"vmk-b\"><path d=\"M10 97h550v576.4H10z\"/></clipPath><clipPath id=\"vmk-c\"><path d=\"M10 94.5h358V491H10z\"/></clipPath><clipPath id=\"vmk-d\"><path d=\"M208 94.5h550V671H208z\"/></clipPath></defs><g clip-path=\"url(#vmk-a)\"><path fill=\"currentColor\" opacity=\".55\" d=\"M 558.605469 278.128906 C 555.410156 277.984375 552.164062 277.90625 548.96875 277.90625 C 466.261719 277.90625 407.433594 327.675781 401.222656 333.144531 L 400.800781 333.59375 C 400.800781 333.59375 587.386719 406.570312 718.046875 673.386719 C 718.046875 673.386719 767.757812 550.011719 756.207031 509.574219 C 740.042969 453 663.917969 362.328125 584.683594 279.359375 L 558.605469 278.128906\"/></g><g clip-path=\"url(#vmk-b)\"><path fill=\"currentColor\" d=\"M 49.953125 673.386719 C 49.953125 673.386719 262.128906 253.59375 559.761719 253.59375 C 497.894531 190.457031 437.765625 134.679688 406.402344 106.136719 C 393.699219 94.574219 374.308594 94.574219 361.601562 106.136719 C 285.859375 175.0625 42.257812 402.917969 11.796875 509.574219 C 0.242188 550.011719 49.953125 673.386719 49.953125 673.386719\"/></g><g clip-path=\"url(#vmk-c)\"><path fill=\"currentColor\" opacity=\".55\" d=\"M 209.394531 489.785156 C 212.589844 489.929688 215.835938 490.007812 219.03125 490.007812 C 301.738281 490.007812 360.566406 440.238281 366.777344 434.765625 L 367.199219 434.316406 C 367.199219 434.316406 180.613281 361.34375 49.953125 94.523438 C 49.953125 94.523438 0.242188 217.902344 11.792969 258.335938 C 27.957031 314.914062 104.082031 405.585938 183.316406 488.554688 L 209.394531 489.785156\"/></g><g clip-path=\"url(#vmk-d)\"><path fill=\"currentColor\" d=\"M 718.046875 94.523438 C 718.046875 94.523438 505.871094 514.316406 208.238281 514.316406 C 270.105469 577.453125 330.234375 633.230469 361.597656 661.773438 C 374.300781 673.335938 393.691406 673.335938 406.398438 661.773438 C 482.140625 592.847656 725.742188 364.992188 756.203125 258.335938 C 767.757812 217.902344 718.046875 94.523438 718.046875 94.523438\"/></g></svg><span>VERSEVA Design<span class=\"stop\">.</span></span></a><span>examples</span><span>ops console</span><a class=\"btn btn-secondary sm codelink\" href=\"../code.html?f=examples/console.html\">Code</a></div>\n<div class=\"app\">\n  <aside>\n    <div class=\"orgchip\"><span class=\"sq\">AC</span><span><b>Acme Console</b><small>production</small></span></div>\n    <div>\n      <div class=\"grouplabel\">Operate</div>\n      <nav class=\"snav\">\n        <a class=\"active\" href=\"#overview\">Overview <span class=\"cnt\">4</span></a>\n        <a href=\"#quotes\">Quotes <span class=\"cnt\">18</span></a>\n        <a href=\"#machines\">Machines <span class=\"cnt\">17</span></a>\n      </nav>\n    </div>\n    <div>\n      <div class=\"grouplabel\">Manage</div>\n      <nav class=\"snav\">\n        <a href=\"#clients\">Clients</a>\n        <a href=\"#settings\">Settings</a>\n      </nav>\n    </div>\n  </aside>\n  <main>\n    <div class=\"mainhead\">\n      <h1>Overview</h1>\n      <div class=\"searchbox\"><input placeholder=\"Search quotes, clients\"><kbd>/</kbd></div>\n      <button class=\"btn btn-secondary sm\" type=\"button\">Export</button>\n      <button class=\"btn btn-primary sm\" type=\"button\">New quote</button>\n    </div>\n    <div class=\"statrow\">\n      <div class=\"stat\"><div class=\"num\">18</div><div class=\"lbl\">Open quotes</div><div class=\"delta\"><span class=\"badge ok\">3 verified today</span></div></div>\n      <div class=\"stat\"><div class=\"num\">4.4<i>ms</i></div><div class=\"lbl\">p95 response</div></div>\n      <div class=\"stat\"><div class=\"num\">97<i>%</i></div><div class=\"lbl\">Provenance complete</div></div>\n      <div class=\"stat\"><div class=\"num\">2</div><div class=\"lbl\">Awaiting ruling</div><div class=\"delta\"><span class=\"badge warn\">Blocked on client</span></div></div>\n    </div>\n    <div class=\"duo\">\n      <div class=\"chartcard\">\n        <h4>Quotes closed</h4>\n        <div class=\"sub\">Last 6 weeks</div>\n        <div class=\"bars\">\n          <div class=\"bar\"><div class=\"fill\" style=\"height:34%\"></div><span class=\"mlab\">W1</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:48%\"></div><span class=\"mlab\">W2</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:41%\"></div><span class=\"mlab\">W3</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:66%\"></div><span class=\"mlab\">W4</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:82%\"></div><span class=\"mlab\">W5</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:100%\"></div><span class=\"mlab\">W6</span></div>\n        </div>\n        <div class=\"takeaway\">Throughput doubled after the provenance sweep landed in W4.</div>\n      </div>\n      <div class=\"card\">\n        <div class=\"hd\"><h4>Recent activity</h4></div>\n        <div class=\"bd\">\n          <div class=\"lrows\">\n            <div class=\"lrow\"><span class=\"avc\">KW</span><span class=\"tx\"><b>Quote 2081 verified</b><span class=\"metaline\">2 minutes ago</span></span><span class=\"badge ok\">Verified</span></div>\n            <div class=\"lrow\"><span class=\"avc\">MR</span><span class=\"tx\"><b>Machine 12 recalibrated</b><span class=\"metaline\">1 hour ago</span></span><span class=\"badge neutral\">Logged</span></div>\n            <div class=\"lrow\"><span class=\"avc\">KW</span><span class=\"tx\"><b>Ruling v18 filed</b><span class=\"metaline\">Yesterday</span></span><span class=\"badge warn\">2 conflicts</span></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <table class=\"table\">\n      <thead><tr><th>Quote</th><th>Client</th><th>Status</th><th class=\"num\">Amount</th></tr></thead>\n      <tbody>\n        <tr><td>Q-2081</td><td>Northline Foods</td><td><span class=\"badge ok\">Verified</span></td><td class=\"num\">48,220.00</td></tr>\n        <tr><td>Q-2080</td><td>Harbor Botanics</td><td><span class=\"badge warn\">Pending sourcing</span></td><td class=\"num\">12,940.00</td></tr>\n        <tr><td>Q-2079</td><td>Crestpoint Labs</td><td><span class=\"badge ok\">Verified</span></td><td class=\"num\">86,410.00</td></tr>\n        <tr><td>Q-2078</td><td>Meridian Goods</td><td><span class=\"badge err\">Rejected</span></td><td class=\"num\">7,300.00</td></tr>\n      </tbody>\n    </table>\n  </main>\n</div>\n<div id=\"toastwrap\"></div>\n<script>\n  const table = document.querySelector('.table tbody');\n  const search = document.querySelector('.searchbox input');\n  search.addEventListener('input', () => {\n    const q = search.value.trim().toLowerCase();\n    [...table.rows].forEach((r) => { r.hidden = q !== '' && !r.textContent.toLowerCase().includes(q); });\n  });\n  const amountTh = document.querySelector('.table th.num');\n  amountTh.style.cursor = 'pointer';\n  let asc = false;\n  amountTh.addEventListener('click', () => {\n    asc = !asc;\n    [...table.rows]\n      .sort((a, b) => {\n        const num = (r) => parseFloat(r.cells[3].textContent.replace(/,/g, ''));\n        return asc ? num(a) - num(b) : num(b) - num(a);\n      })\n      .forEach((r) => table.append(r));\n  });\n  document.querySelectorAll('.mainhead .btn').forEach((btn) => {\n    btn.addEventListener('click', () => {\n      const wrap = document.getElementById('toastwrap');\n      wrap.replaceChildren();\n      const toast = document.createElement('div');\n      toast.className = 'toast ok';\n      toast.style.position = 'fixed';\n      toast.style.right = 'var(--s-5)';\n      toast.style.bottom = 'var(--s-5)';\n      toast.style.zIndex = '9';\n      toast.innerHTML = '<span class=\"dot\"></span>' + (btn.textContent.includes('Export') ? 'Export queued: 18 quotes.' : 'Draft quote Q-2082 opened.');\n      wrap.append(toast);\n      setTimeout(() => toast.remove(), 2200);\n    });\n  });\n  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    document.querySelectorAll('.stat .num').forEach((el) => {\n      const target = el.firstChild.textContent.trim();\n      if (!/^\\d+$/.test(target)) return;\n      const n = parseInt(target, 10);\n      let cur = 0;\n      const step = Math.max(1, Math.round(n / 24));\n      const tick = () => {\n        cur = Math.min(n, cur + step);\n        el.firstChild.textContent = cur;\n        if (cur < n) requestAnimationFrame(tick);\n      };\n      el.firstChild.textContent = '0';\n      requestAnimationFrame(tick);\n    });\n  }\n</script>\n</body>\n</html>\n"
    }
  ]
}
