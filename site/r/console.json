  "files": [
    {
      "path": "console.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VERSEVA Design · Example: ops console</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500..700&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap\">\n<link rel=\"stylesheet\" href=\"../../tokens.css?v=1p2\">\n<link rel=\"stylesheet\" href=\"../../components.css?v=1p2\">\n<style>\n  * { margin: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); font-size: 15px; line-height: 1.5; }\n  .crumb { position: sticky; top: 0; z-index: 10; background: var(--bg); display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--hairline); font-size: 12.5px; color: var(--text-3); }\n  .crumb a { color: var(--text-2); text-decoration: none; font-family: var(--font-display); font-weight: var(--display-weight); }\n  .app { display: grid; grid-template-columns: 232px 1fr; min-height: 92vh; }\n  aside { border-right: 1px solid var(--hairline); padding: var(--s-4); display: grid; gap: var(--s-4); align-content: start; }\n  main { padding: var(--s-5) var(--s-6); display: grid; gap: var(--s-5); align-content: start; }\n  .mainhead { display: flex; align-items: center; gap: var(--s-4); }\n  .mainhead h1 { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 20px; letter-spacing: -0.015em; flex: 1; }\n  .duo { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--s-4); }\n  main { min-width: 0; grid-template-columns: minmax(0, 1fr); }\n  .quotes td { white-space: nowrap; }\n  @media (max-width: 900px) {\n    .app { grid-template-columns: minmax(0, 1fr); } aside { display: none; } .duo { grid-template-columns: minmax(0, 1fr); }\n    main { padding: var(--s-4); }\n    .mainhead { flex-wrap: wrap; }\n    .mainhead h1 { flex: 1 1 100%; }\n    .mainhead .searchbox { flex: 1 1 100%; max-width: none; }\n  }\n  @media (max-width: 600px) { .quotes .client { display: none; } .quotes .table th, .quotes .table td { padding-inline: var(--s-3); } }\n  .crumb a { display: inline-flex; align-items: center; gap: 8px; }\n  .crumb .vmark { width: 16px; height: 16px; flex: none; }\n  .crumb .codelink { margin-left: auto; }\n</style>\n</head>\n<body>\n<div class=\"crumb\"><a href=\"../index.html\"><svg class=\"vmark\" viewBox=\"0 0 768 775.92\" aria-hidden=\"true\"><defs><clipPath id=\"vmk-a\"><path d=\"M400 277h358v396.4H400z\"/></clipPath><clipPath id=\"vmk-b\"><path d=\"M10 97h550v576.4H10z\"/></clipPath><clipPath id=\"vmk-c\"><path d=\"M10 94.5h358V491H10z\"/></clipPath><clipPath id=\"vmk-d\"><path d=\"M208 94.5h550V671H208z\"/></clipPath></defs><g clip-path=\"url(#vmk-a)\"><path fill=\"currentColor\" opacity=\".55\" d=\"M 558.605469 278.128906 C 555.410156 277.984375 552.164062 277.90625 548.96875 277.90625 C 466.261719 277.90625 407.433594 327.675781 401.222656 333.144531 L 400.800781 333.59375 C 400.800781 333.59375 587.386719 406.570312 718.046875 673.386719 C 718.046875 673.386719 767.757812 550.011719 756.207031 509.574219 C 740.042969 453 663.917969 362.328125 584.683594 279.359375 L 558.605469 278.128906\"/></g><g clip-path=\"url(#vmk-b)\"><path fill=\"currentColor\" d=\"M 49.953125 673.386719 C 49.953125 673.386719 262.128906 253.59375 559.761719 253.59375 C 497.894531 190.457031 437.765625 134.679688 406.402344 106.136719 C 393.699219 94.574219 374.308594 94.574219 361.601562 106.136719 C 285.859375 175.0625 42.257812 402.917969 11.796875 509.574219 C 0.242188 550.011719 49.953125 673.386719 49.953125 673.386719\"/></g><g clip-path=\"url(#vmk-c)\"><path fill=\"currentColor\" opacity=\".55\" d=\"M 209.394531 489.785156 C 212.589844 489.929688 215.835938 490.007812 219.03125 490.007812 C 301.738281 490.007812 360.566406 440.238281 366.777344 434.765625 L 367.199219 434.316406 C 367.199219 434.316406 180.613281 361.34375 49.953125 94.523438 C 49.953125 94.523438 0.242188 217.902344 11.792969 258.335938 C 27.957031 314.914062 104.082031 405.585938 183.316406 488.554688 L 209.394531 489.785156\"/></g><g clip-path=\"url(#vmk-d)\"><path fill=\"currentColor\" d=\"M 718.046875 94.523438 C 718.046875 94.523438 505.871094 514.316406 208.238281 514.316406 C 270.105469 577.453125 330.234375 633.230469 361.597656 661.773438 C 374.300781 673.335938 393.691406 673.335938 406.398438 661.773438 C 482.140625 592.847656 725.742188 364.992188 756.203125 258.335938 C 767.757812 217.902344 718.046875 94.523438 718.046875 94.523438\"/></g></svg><span>VERSEVA Design</span></a><span>examples</span><span>ops console</span><a class=\"btn btn-secondary sm codelink\" href=\"../code.html?f=examples/console.html\">Code</a></div>\n<div class=\"app\">\n  <aside>\n    <div class=\"orgchip\"><span class=\"sq\">AC</span><span><b>Acme Console</b><small>production</small></span></div>\n    <div>\n      <div class=\"grouplabel\">Operate</div>\n      <nav class=\"snav\">\n        <a href=\"#overview\" aria-current=\"page\">Overview <span class=\"cnt\">4</span></a>\n        <a href=\"#quotes\">Quotes <span class=\"cnt\">18</span></a>\n        <a href=\"#machines\">Machines <span class=\"cnt\">17</span></a>\n      </nav>\n    </div>\n    <div>\n      <div class=\"grouplabel\">Manage</div>\n      <nav class=\"snav\">\n        <a href=\"#clients\">Clients</a>\n        <a href=\"#settings\">Settings</a>\n      </nav>\n    </div>\n  </aside>\n  <main>\n    <div class=\"mainhead\">\n      <h1>Overview</h1>\n      <div class=\"searchbox\"><input placeholder=\"Search quotes, clients\"><kbd>/</kbd></div>\n      <button class=\"btn btn-secondary sm\" type=\"button\">Export</button>\n      <button class=\"btn btn-primary sm\" type=\"button\">New quote</button>\n    </div>\n    <div class=\"statrow\">\n      <div class=\"stat glass\"><div class=\"num\">18</div><div class=\"lbl\">Open quotes</div><div class=\"delta\"><span class=\"badge ok\">3 verified today</span></div></div>\n      <div class=\"stat glass\"><div class=\"num\">4.4<i>ms</i></div><div class=\"lbl\">p95 response</div></div>\n      <div class=\"stat glass\"><div class=\"num\">97<i>%</i></div><div class=\"lbl\">Provenance complete</div></div>\n      <div class=\"stat glass\"><div class=\"num\">2</div><div class=\"lbl\">Awaiting ruling</div><div class=\"delta\"><span class=\"badge warn\">Blocked on client</span></div></div>\n    </div>\n    <div class=\"duo\">\n      <div class=\"chartcard glass\">\n        <h4>Quotes closed</h4>\n        <div class=\"sub\">Last 6 weeks</div>\n        <div class=\"bars\">\n          <div class=\"bar\"><div class=\"fill\" style=\"height:34%\"></div><span class=\"mlab\">W1</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:48%\"></div><span class=\"mlab\">W2</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:41%\"></div><span class=\"mlab\">W3</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:66%\"></div><span class=\"mlab\">W4</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:82%\"></div><span class=\"mlab\">W5</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:100%\"></div><span class=\"mlab\">W6</span></div>\n        </div>\n        <div class=\"takeaway\">Throughput doubled after the provenance sweep landed in W4.</div>\n      </div>\n      <section class=\"glass\">\n        <div class=\"hd\"><h4>Recent activity</h4><span class=\"badge neutral\">3</span></div>\n        <ol class=\"lrows tline\">\n          <li class=\"lrow\"><span class=\"avc\" title=\"Verified\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg></span><span class=\"tx\"><b>Quote 2081 verified</b><span class=\"metaline\">K. Webb · <time datetime=\"PT2M\">2 minutes ago</time></span></span><span class=\"badge ok\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"m2 5.2 2 2 4-4.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verified</span></li>\n          <li class=\"lrow\"><span class=\"avc\" title=\"Machine\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1\"/></svg></span><span class=\"tx\"><b>Machine 12 recalibrated</b><span class=\"metaline\">M. Reyes · <time datetime=\"PT1H\">1 hour ago</time></span></span><span class=\"badge neutral\">Logged</span></li>\n          <li class=\"lrow\"><span class=\"avc\" title=\"Ruling\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M6 3h9l4 4v14H6z\"/><path d=\"M9 12h6M9 16h4\"/></svg></span><span class=\"tx\"><b>Ruling v18 filed</b><span class=\"metaline\">K. Webb · <time datetime=\"P1D\">Yesterday</time></span></span><span class=\"badge warn\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"currentColor\"/></svg>2 conflicts</span></li>\n        </ol>\n      </section>\n    </div>\n    <section class=\"glass quotes\">\n      <div class=\"hd\"><h4>Quotes</h4><span class=\"badge neutral\">4</span></div>\n      <table class=\"table\">\n        <thead><tr><th class=\"pick\"><label><input type=\"checkbox\" aria-label=\"Select all quotes\"></label></th><th>Quote</th><th class=\"client\">Client</th><th>Status</th><th class=\"num\">Amount</th></tr></thead>\n        <tbody>\n          <tr><td class=\"pick\"><label><input type=\"checkbox\" aria-label=\"Select Q-2081\"></label></td><td>Q-2081</td><td class=\"client\">Northline Foods</td><td><div class=\"menu inline\"><button type=\"button\" class=\"btn btn-ghost sm\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"Status of Q-2081\"><span class=\"badge ok\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"m2 5.2 2 2 4-4.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verified</span></button></div></td><td class=\"num\">48,220.00</td></tr>\n          <tr><td class=\"pick\"><label><input type=\"checkbox\" aria-label=\"Select Q-2080\"></label></td><td>Q-2080</td><td class=\"client\">Harbor Botanics</td><td><div class=\"menu inline\"><button type=\"button\" class=\"btn btn-ghost sm\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"Status of Q-2080\"><span class=\"badge warn\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"currentColor\"/></svg>Pending</span></button></div></td><td class=\"num\">12,940.00</td></tr>\n          <tr><td class=\"pick\"><label><input type=\"checkbox\" aria-label=\"Select Q-2079\"></label></td><td>Q-2079</td><td class=\"client\">Crestpoint Labs</td><td><div class=\"menu inline\"><button type=\"button\" class=\"btn btn-ghost sm\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"Status of Q-2079\"><span class=\"badge ok\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"m2 5.2 2 2 4-4.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verified</span></button></div></td><td class=\"num\">86,410.00</td></tr>\n          <tr><td class=\"pick\"><label><input type=\"checkbox\" aria-label=\"Select Q-2078\"></label></td><td>Q-2078</td><td class=\"client\">Meridian Goods</td><td><div class=\"menu inline\"><button type=\"button\" class=\"btn btn-ghost sm\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"Status of Q-2078\"><span class=\"badge err\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"m3 3 4 4M7 3 3 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>Rejected</span></button></div></td><td class=\"num\">7,300.00</td></tr>\n        </tbody>\n      </table>\n    </section>\n    <div class=\"bulkbar\" role=\"toolbar\" aria-label=\"Bulk actions\" hidden>\n      <span class=\"count\" aria-live=\"polite\">0 selected</span>\n      <button class=\"btn btn-ghost sm\" type=\"button\" data-bulk=\"Exported\">Export</button>\n      <button class=\"btn btn-destructive sm\" type=\"button\" data-bulk=\"Rejected\">Reject</button>\n      <button class=\"btn btn-ghost sm icon\" type=\"button\" aria-label=\"Clear selection\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button>\n    </div>\n  </main>\n</div>\n<div id=\"toastwrap\"></div>\n<script>\n  const table = document.querySelector('.quotes tbody');\n  const MENU = '<div class=\"menu-list\" role=\"menu\" aria-label=\"Status\"><button type=\"button\" role=\"menuitemradio\" aria-checked=\"false\" class=\"menu-item\" data-k=\"ok\"><span class=\"badge ok\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"m2 5.2 2 2 4-4.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verified</span><svg class=\"tick\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg></button><button type=\"button\" role=\"menuitemradio\" aria-checked=\"false\" class=\"menu-item\" data-k=\"warn\"><span class=\"badge warn\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"currentColor\"/></svg>Pending</span><svg class=\"tick\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg></button><button type=\"button\" role=\"menuitemradio\" aria-checked=\"false\" class=\"menu-item\" data-k=\"err\"><span class=\"badge err\"><svg viewBox=\"0 0 10 10\" aria-hidden=\"true\"><path d=\"m3 3 4 4M7 3 3 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>Rejected</span><svg class=\"tick\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg></button></div>';\n  const search = document.querySelector('.searchbox input');\n  search.addEventListener('input', () => {\n    const q = search.value.trim().toLowerCase();\n    [...table.rows].forEach((r) => { r.hidden = q !== '' && !r.textContent.toLowerCase().includes(q); });\n  });\n  const amountTh = document.querySelector('.quotes th.num');\n  amountTh.style.cursor = 'pointer';\n  let asc = false;\n  amountTh.addEventListener('click', () => {\n    asc = !asc;\n    [...table.rows]\n      .sort((a, b) => {\n        const num = (r) => parseFloat(r.cells[4].textContent.replace(/,/g, ''));\n        return asc ? num(a) - num(b) : num(b) - num(a);\n      })\n      .forEach((r) => table.append(r));\n  });\n  const toast = (text) => {\n    const wrap = document.getElementById('toastwrap');\n    wrap.replaceChildren();\n    const t = document.createElement('div');\n    t.className = 'toast ok';\n    t.setAttribute('role', 'status');\n    t.style.position = 'fixed';\n    t.style.right = 'var(--s-5)';\n    t.style.bottom = 'var(--s-5)';\n    t.style.zIndex = '13';\n    t.innerHTML = '<span class=\"dot\"></span>' + text;\n    wrap.append(t);\n    setTimeout(() => t.remove(), 2200);\n  };\n\n  /* Row menu: the status badge is the trigger; the checked item carries a tick */\n  const closeMenus = () => document.querySelectorAll('.menu.inline').forEach((m) => {\n    m.querySelector('.menu-list')?.remove();\n    m.querySelector('[aria-haspopup]').setAttribute('aria-expanded', 'false');\n  });\n  table.addEventListener('click', (e) => {\n    const trigger = e.target.closest('.menu.inline > [aria-haspopup]');\n    const item = e.target.closest('[role=\"menuitemradio\"]');\n    if (item) {\n      const menu = item.closest('.menu');\n      const btn = menu.querySelector('[aria-haspopup]');\n      const value = item.cloneNode(true);\n      value.querySelector('.tick').remove();\n      btn.innerHTML = value.innerHTML;\n      closeMenus();\n      btn.focus();\n      toast(menu.closest('tr').cells[1].textContent + ' set to ' + value.textContent + '.');\n      return;\n    }\n    if (!trigger) return;\n    const open = trigger.getAttribute('aria-expanded') === 'true';\n    closeMenus();\n    if (open) return;\n    trigger.insertAdjacentHTML('afterend', MENU);\n    const current = trigger.textContent.trim();\n    trigger.nextElementSibling.querySelectorAll('[role=\"menuitemradio\"]').forEach((i) => i.setAttribute('aria-checked', String(i.textContent.trim() === current)));\n    trigger.setAttribute('aria-expanded', 'true');\n    trigger.nextElementSibling.querySelector('[aria-checked=\"true\"]').focus();\n  });\n  addEventListener('pointerdown', (e) => { if (!e.target.closest('.menu.inline')) closeMenus(); });\n  addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenus(); });\n\n  /* Bulk selection: picked rows tint, the bar counts them */\n  const all = document.querySelector('.quotes thead .pick input');\n  const boxes = [...table.querySelectorAll('.pick input')];\n  const bar = document.querySelector('.bulkbar');\n  const sync = () => {\n    const n = boxes.filter((b) => b.checked).length;\n    boxes.forEach((b) => {\n      const tr = b.closest('tr');\n      if (b.checked) tr.setAttribute('aria-selected', 'true'); else tr.removeAttribute('aria-selected');\n    });\n    all.checked = n === boxes.length;\n    all.indeterminate = n > 0 && n < boxes.length;\n    bar.hidden = n === 0;\n    bar.querySelector('.count').textContent = n + ' selected';\n  };\n  const clear = () => { boxes.forEach((b) => { b.checked = false; }); sync(); };\n  boxes.forEach((b) => b.addEventListener('change', sync));\n  all.addEventListener('change', () => { boxes.forEach((b) => { b.checked = all.checked; }); sync(); });\n  bar.querySelector('[aria-label=\"Clear selection\"]').addEventListener('click', () => { clear(); all.focus(); });\n  bar.querySelectorAll('[data-bulk]').forEach((btn) => btn.addEventListener('click', () => {\n    const n = boxes.filter((b) => b.checked).length;\n    toast(btn.dataset.bulk + ': ' + n + (n === 1 ? ' quote.' : ' quotes.'));\n    clear();\n  }));\n  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !bar.hidden) clear(); });\n\n  document.querySelectorAll('.mainhead .btn').forEach((btn) => {\n    btn.addEventListener('click', () => toast(btn.textContent.includes('Export') ? 'Export queued: 18 quotes.' : 'Draft quote Q-2082 opened.'));\n  });\n  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    document.querySelectorAll('.stat .num').forEach((el) => {\n      const target = el.firstChild.textContent.trim();\n      if (!/^\\d+$/.test(target)) return;\n      const n = parseInt(target, 10);\n      let cur = 0;\n      const step = Math.max(1, Math.round(n / 24));\n      const tick = () => {\n        cur = Math.min(n, cur + step);\n        el.firstChild.textContent = cur;\n        if (cur < n) requestAnimationFrame(tick);\n      };\n      el.firstChild.textContent = '0';\n      requestAnimationFrame(tick);\n    });\n  }\n</script>\n</body>\n</html>\n"
    }
  ]
}
