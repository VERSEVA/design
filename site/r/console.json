{
  "name": "console",
  "kind": "block",
  "description": "Ops console: sidebar, stats, chart, sortable table, live search",
  "deps": [],
  "files": [
    {
      "path": "console.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VERSEVA Design · Example: ops console</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500..700&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap\">\n<link rel=\"stylesheet\" href=\"../../tokens.css?v=red1\">\n<link rel=\"stylesheet\" href=\"../../components.css?v=red1\">\n<style>\n  * { margin: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); font-size: 15px; line-height: 1.5; }\n  .crumb { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--hairline); font-size: 12.5px; color: var(--text-3); }\n  .crumb a { color: var(--text-2); text-decoration: none; font-family: var(--font-display); font-weight: var(--display-weight); }\n  .crumb .stop { color: var(--accent); }\n  .app { display: grid; grid-template-columns: 232px 1fr; min-height: 92vh; }\n  aside { border-right: 1px solid var(--hairline); padding: var(--s-4); display: grid; gap: var(--s-4); align-content: start; }\n  main { padding: var(--s-5) var(--s-6); display: grid; gap: var(--s-5); align-content: start; }\n  .mainhead { display: flex; align-items: center; gap: var(--s-4); }\n  .mainhead h1 { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 20px; letter-spacing: -0.015em; flex: 1; }\n  .duo { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--s-4); }\n  @media (max-width: 900px) { .app { grid-template-columns: 1fr; } aside { display: none; } .duo { grid-template-columns: 1fr; } }\n</style>\n</head>\n<body>\n<div class=\"crumb\"><a href=\"../index.html\">VERSEVA Design<span class=\"stop\">.</span></a><span>examples</span><span>ops console</span></div>\n<div class=\"app\">\n  <aside>\n    <div class=\"orgchip\"><span class=\"sq\">AC</span><span><b>Acme Console</b><small>production</small></span></div>\n    <div>\n      <div class=\"grouplabel\">Operate</div>\n      <nav class=\"snav\">\n        <a class=\"active\" href=\"#overview\">Overview <span class=\"cnt\">4</span></a>\n        <a href=\"#quotes\">Quotes <span class=\"cnt\">18</span></a>\n        <a href=\"#machines\">Machines <span class=\"cnt\">17</span></a>\n      </nav>\n    </div>\n    <div>\n      <div class=\"grouplabel\">Manage</div>\n      <nav class=\"snav\">\n        <a href=\"#clients\">Clients</a>\n        <a href=\"#settings\">Settings</a>\n      </nav>\n    </div>\n  </aside>\n  <main>\n    <div class=\"mainhead\">\n      <h1>Overview</h1>\n      <div class=\"searchbox\"><input placeholder=\"Search quotes, clients\"><kbd>/</kbd></div>\n      <button class=\"btn btn-secondary sm\" type=\"button\">Export</button>\n      <button class=\"btn btn-primary sm\" type=\"button\">New quote</button>\n    </div>\n    <div class=\"statrow\">\n      <div class=\"stat\"><div class=\"num\">18</div><div class=\"lbl\">Open quotes</div><div class=\"delta\"><span class=\"badge ok\">3 verified today</span></div></div>\n      <div class=\"stat\"><div class=\"num\">4.4<i>ms</i></div><div class=\"lbl\">p95 response</div></div>\n      <div class=\"stat\"><div class=\"num\">97<i>%</i></div><div class=\"lbl\">Provenance complete</div></div>\n      <div class=\"stat\"><div class=\"num\">2</div><div class=\"lbl\">Awaiting ruling</div><div class=\"delta\"><span class=\"badge warn\">Blocked on client</span></div></div>\n    </div>\n    <div class=\"duo\">\n      <div class=\"chartcard\">\n        <h4>Quotes closed</h4>\n        <div class=\"sub\">Last 6 weeks</div>\n        <div class=\"bars\">\n          <div class=\"bar\"><div class=\"fill\" style=\"height:34%\"></div><span class=\"mlab\">W1</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:48%\"></div><span class=\"mlab\">W2</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:41%\"></div><span class=\"mlab\">W3</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:66%\"></div><span class=\"mlab\">W4</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:82%\"></div><span class=\"mlab\">W5</span></div>\n          <div class=\"bar\"><div class=\"fill\" style=\"height:100%\"></div><span class=\"mlab\">W6</span></div>\n        </div>\n        <div class=\"takeaway\">Throughput doubled after the provenance sweep landed in W4.</div>\n      </div>\n      <div class=\"card\">\n        <div class=\"hd\"><h4>Recent activity</h4></div>\n        <div class=\"bd\">\n          <div class=\"lrows\">\n            <div class=\"lrow\"><span class=\"avc\">KW</span><span class=\"tx\"><b>Quote 2081 verified</b><span class=\"metaline\">2 minutes ago</span></span><span class=\"badge ok\">Verified</span></div>\n            <div class=\"lrow\"><span class=\"avc\">MR</span><span class=\"tx\"><b>Machine 12 recalibrated</b><span class=\"metaline\">1 hour ago</span></span><span class=\"badge neutral\">Logged</span></div>\n            <div class=\"lrow\"><span class=\"avc\">KW</span><span class=\"tx\"><b>Ruling v18 filed</b><span class=\"metaline\">Yesterday</span></span><span class=\"badge warn\">2 conflicts</span></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <table class=\"table\">\n      <thead><tr><th>Quote</th><th>Client</th><th>Status</th><th class=\"num\">Amount</th></tr></thead>\n      <tbody>\n        <tr><td>Q-2081</td><td>Northline Foods</td><td><span class=\"badge ok\">Verified</span></td><td class=\"num\">48,220.00</td></tr>\n        <tr><td>Q-2080</td><td>Harbor Botanics</td><td><span class=\"badge warn\">Pending sourcing</span></td><td class=\"num\">12,940.00</td></tr>\n        <tr><td>Q-2079</td><td>Crestpoint Labs</td><td><span class=\"badge ok\">Verified</span></td><td class=\"num\">86,410.00</td></tr>\n        <tr><td>Q-2078</td><td>Meridian Goods</td><td><span class=\"badge err\">Rejected</span></td><td class=\"num\">7,300.00</td></tr>\n      </tbody>\n    </table>\n  </main>\n</div>\n<div id=\"toastwrap\"></div>\n<script>\n  const table = document.querySelector('.table tbody');\n  const search = document.querySelector('.searchbox input');\n  search.addEventListener('input', () => {\n    const q = search.value.trim().toLowerCase();\n    [...table.rows].forEach((r) => { r.hidden = q !== '' && !r.textContent.toLowerCase().includes(q); });\n  });\n  const amountTh = document.querySelector('.table th.num');\n  amountTh.style.cursor = 'pointer';\n  let asc = false;\n  amountTh.addEventListener('click', () => {\n    asc = !asc;\n    [...table.rows]\n      .sort((a, b) => {\n        const num = (r) => parseFloat(r.cells[3].textContent.replace(/,/g, ''));\n        return asc ? num(a) - num(b) : num(b) - num(a);\n      })\n      .forEach((r) => table.append(r));\n  });\n  document.querySelectorAll('.mainhead .btn').forEach((btn) => {\n    btn.addEventListener('click', () => {\n      const wrap = document.getElementById('toastwrap');\n      wrap.replaceChildren();\n      const toast = document.createElement('div');\n      toast.className = 'toast ok';\n      toast.style.position = 'fixed';\n      toast.style.right = 'var(--s-5)';\n      toast.style.bottom = 'var(--s-5)';\n      toast.style.zIndex = '9';\n      toast.innerHTML = '<span class=\"dot\"></span>' + (btn.textContent.includes('Export') ? 'Export queued: 18 quotes.' : 'Draft quote Q-2082 opened.');\n      wrap.append(toast);\n      setTimeout(() => toast.remove(), 2200);\n    });\n  });\n  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    document.querySelectorAll('.stat .num').forEach((el) => {\n      const target = el.firstChild.textContent.trim();\n      if (!/^\\d+$/.test(target)) return;\n      const n = parseInt(target, 10);\n      let cur = 0;\n      const step = Math.max(1, Math.round(n / 24));\n      const tick = () => {\n        cur = Math.min(n, cur + step);\n        el.firstChild.textContent = cur;\n        if (cur < n) requestAnimationFrame(tick);\n      };\n      el.firstChild.textContent = '0';\n      requestAnimationFrame(tick);\n    });\n  }\n</script>\n</body>\n</html>\n"
    }
  ]
}
