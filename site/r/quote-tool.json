{
  "name": "quote-tool",
  "kind": "block",
  "description": "Pricing tool: live recompute, freight toggle, rush-ruling gate",
  "deps": [],
  "files": [
    {
      "path": "quote-tool.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VERSEVA Design · Example: quote tool</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500..700&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap\">\n<link rel=\"stylesheet\" href=\"../../tokens.css?v=red1\">\n<link rel=\"stylesheet\" href=\"../../components.css?v=red1\">\n<style>\n  * { margin: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); font-size: 15px; line-height: 1.5; }\n  .crumb { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--hairline); font-size: 12.5px; color: var(--text-3); }\n  .crumb a { color: var(--text-2); text-decoration: none; font-family: var(--font-display); font-weight: var(--display-weight); }\n  .stop { color: var(--accent); }\n  .tool { max-width: 64rem; margin: 0 auto; padding: var(--s-6) var(--s-5) var(--s-8); display: grid; gap: var(--s-5); }\n  .toolhead { display: flex; align-items: center; gap: var(--s-4); }\n  .toolhead h1 { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 20px; letter-spacing: -0.015em; flex: 1; }\n  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--s-5); align-items: start; }\n  .formgrid { display: grid; gap: var(--s-4); }\n  .formrow { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }\n  .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }\n  .sumfoot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding-top: var(--s-4); }\n  .total b { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 26px; letter-spacing: -0.01em; }\n  .total span { display: block; font-size: 11.5px; color: var(--text-3); }\n  @media (max-width: 820px) { .split, .formrow { grid-template-columns: 1fr; } }\n</style>\n</head>\n<body>\n<div class=\"crumb\"><a href=\"../index.html\">VERSEVA Design<span class=\"stop\">.</span></a><span>examples</span><span>quote tool</span></div>\n<div class=\"tool\">\n  <div class=\"toolhead\">\n    <h1>New quote</h1>\n    <div class=\"seg\"><button type=\"button\" aria-selected=\"true\">Bottling</button><button type=\"button\">Labeling</button><button type=\"button\">Kitting</button></div>\n  </div>\n  <div class=\"split\">\n    <div class=\"card\">\n      <div class=\"hd\"><h4>Request</h4></div>\n      <div class=\"bd formgrid\">\n        <div class=\"field\"><label for=\"q-client\">Client</label><input id=\"q-client\" value=\"Northline Foods\"></div>\n        <div class=\"formrow\">\n          <div class=\"field\"><label for=\"q-units\">Units</label><input id=\"q-units\" class=\"mono\" value=\"24,000\"></div>\n          <div class=\"field\"><label for=\"q-size\">Bottle size</label><input id=\"q-size\" value=\"500 ml PET\"></div>\n        </div>\n        <div class=\"formrow\">\n          <div class=\"field\"><label for=\"q-cap\">Closure</label><input id=\"q-cap\" value=\"38 mm tamper-evident\"></div>\n          <div class=\"field error\"><label for=\"q-date\">Needed by</label><input id=\"q-date\" value=\"2026-09-08\"><div class=\"help\">Inside the 10-day floor: needs a rush ruling.</div></div>\n        </div>\n        <label class=\"sel switch-wrap\"><input class=\"sw\" type=\"checkbox\" checked id=\"freight-toggle\"><span class=\"switch\"></span>Include freight estimate</label>\n      </div>\n      <div class=\"ft\"><button class=\"btn btn-ghost\" type=\"button\" id=\"save-draft\">Save draft</button><button class=\"btn btn-primary\" type=\"button\" id=\"price-it\">Price it</button></div>\n    </div>\n    <div class=\"card\">\n      <div class=\"hd\"><h4>Quote summary</h4></div>\n      <div class=\"bd\">\n        <div class=\"lrows\">\n          <div class=\"lrow\"><span class=\"tx\"><b>Run setup</b><span class=\"metaline\">machine 12 · changeover</span></span><span class=\"val mono\" id=\"v-setup\">1,840.00</span></div>\n          <div class=\"lrow\"><span class=\"tx\"><b id=\"fill-label\">Fill + cap, 24,000 u</b><span class=\"metaline\">rate card v18</span></span><span class=\"val mono\" id=\"v-fill\">9,360.00</span></div>\n          <div class=\"lrow\"><span class=\"tx\"><b>Materials</b><span class=\"metaline\">sourced · 3 vendors</span></span><span class=\"val mono\" id=\"v-mat\">6,120.00</span></div>\n          <div class=\"lrow\" id=\"row-freight\"><span class=\"tx\"><b>Freight estimate</b><span class=\"metaline\">to Columbus OH</span></span><span class=\"val mono\" id=\"v-freight\">740.00</span></div>\n        </div>\n        <div class=\"sumfoot\">\n          <span class=\"total\"><b class=\"mono\" id=\"v-total\">18,060.00</b><span>every line carries provenance</span></span>\n          <span class=\"badge warn\" id=\"rush-badge\">Rush ruling needed</span>\n        </div>\n      </div>\n      <div class=\"ft\"><button class=\"btn btn-secondary\" type=\"button\" id=\"provenance\">Provenance</button><button class=\"btn btn-primary\" type=\"button\" id=\"issue\">Issue quote</button></div>\n    </div>\n  </div>\n</div>\n<div id=\"toastwrap\"></div>\n<style>\n  #toastwrap .toast { position: fixed; right: var(--s-5); bottom: var(--s-5); z-index: 9; }\n</style>\n<script>\n  const $ = (id) => document.getElementById(id);\n  const SETUP = 1840, FILL_RATE = 0.39, MAT_RATE = 0.255, FREIGHT = 740, RUSH_FLOOR = '2026-09-15';\n  const fmt = (n) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  const units = () => {\n    const n = parseInt(($('q-units').value || '').replace(/[^\\d]/g, ''), 10);\n    return Number.isFinite(n) && n > 0 ? n : 0;\n  };\n  function toast(text, cls) {\n    const wrap = $('toastwrap');\n    wrap.replaceChildren();\n    const t = document.createElement('div');\n    t.className = 'toast ' + (cls || 'ok');\n    t.innerHTML = '<span class=\"dot\"></span>' + text;\n    wrap.append(t);\n    setTimeout(() => t.remove(), 2400);\n  }\n  function recalc() {\n    const u = units();\n    const freightOn = $('freight-toggle').checked;\n    const fill = u * FILL_RATE, mat = u * MAT_RATE, freight = freightOn ? FREIGHT : 0;\n    $('fill-label').textContent = 'Fill + cap, ' + u.toLocaleString('en-US') + ' u';\n    $('v-fill').textContent = fmt(fill);\n    $('v-mat').textContent = fmt(mat);\n    $('row-freight').hidden = !freightOn;\n    $('v-total').textContent = fmt(SETUP + fill + mat + freight);\n    const dateField = $('q-date').closest('.field');\n    const rush = $('q-date').value.trim() < RUSH_FLOOR;\n    dateField.classList.toggle('error', rush);\n    dateField.querySelector('.help').textContent = rush ? 'Inside the 10-day floor: needs a rush ruling.' : 'Inside the standard window.';\n    $('rush-badge').hidden = !rush;\n  }\n  ['q-units', 'q-date'].forEach((id) => $(id).addEventListener('input', recalc));\n  $('freight-toggle').addEventListener('change', recalc);\n  $('price-it').addEventListener('click', () => { recalc(); toast('Priced: every line carries provenance.'); });\n  $('save-draft').addEventListener('click', () => toast('Draft saved to the desk.'));\n  $('provenance').addEventListener('click', () => toast('4 sources attached · rate card v18, 3 vendor quotes.'));\n  $('issue').addEventListener('click', () => {\n    if ($('q-date').value.trim() < RUSH_FLOOR) { toast('Blocked: rush ruling still open.', 'err'); return; }\n    toast('Quote issued to ' + ($('q-client').value || 'the client') + '.');\n  });\n  document.querySelectorAll('.seg button').forEach((b) => b.addEventListener('click', () => {\n    document.querySelectorAll('.seg button').forEach((x) => x.setAttribute('aria-selected', x === b ? 'true' : 'false'));\n  }));\n  recalc();\n</script>\n</body>\n</html>\n"
    }
  ]
}
