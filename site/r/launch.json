{
  "name": "launch",
  "kind": "block",
  "description": "Launch landing: the motion kit assembled — line reveal, spotlight, magnetic CTA, rolling stats, theme wipe",
  "deps": [],
  "files": [
    {
      "path": "launch.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VERSEVA Design · Example: Launch</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500..700&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap\">\n<link rel=\"stylesheet\" href=\"../../tokens.css?v=red1\">\n<link rel=\"stylesheet\" href=\"../../components.css?v=red1\">\n<style>\n  * { margin: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); font-size: 15px; line-height: 1.5; overflow-x: hidden; }\n  .crumb { position: sticky; top: 0; z-index: 10; background: var(--bg); display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--hairline); font-size: 12.5px; color: var(--text-3); position: relative; z-index: 2; }\n  .crumb a { color: var(--text-2); text-decoration: none; font-family: var(--font-display); font-weight: var(--display-weight); }\n  \n  .stop { color: var(--accent); }\n  .wrap { max-width: 66rem; margin: 0 auto; padding: 0 var(--s-5); position: relative; z-index: 1; }\n\n  /* The light arrives AFTER the words: a static blur, animated only on transform/opacity */\n  .glow { position: absolute; top: -220px; left: 50%; width: 720px; height: 480px; pointer-events: none; z-index: 0;\n    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent) 22%, transparent), transparent 65%);\n    filter: blur(80px); opacity: 0; transform: translate(-50%, -18%) scale(.7); }\n  @media (prefers-reduced-motion: no-preference) {\n    .glow { animation: lands 1.6s var(--ease-entrance) .7s forwards; }\n  }\n  @media (prefers-reduced-motion: reduce) { .glow { opacity: .55; transform: translate(-50%, 0) scale(1); } }\n  @keyframes lands { to { opacity: .55; transform: translate(-50%, 0) scale(1); } }\n\n  .hero { padding: calc(var(--s-8) + var(--s-6)) 0 var(--s-7); text-align: center; }\n  .kicker { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; color: var(--text-3); text-transform: uppercase; }\n  .hero h1 { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(40px, 7vw, 64px); letter-spacing: -0.025em; line-height: 1.12; padding-top: var(--s-4); }\n  .hero .sub { color: var(--text-2); max-width: 46ch; margin: 0 auto; padding-top: var(--s-4); }\n  .cta { display: flex; justify-content: center; align-items: center; gap: var(--s-4); padding-top: var(--s-6); }\n  .ctanote { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-3); }\n\n  .statrow.launch { max-width: 46rem; margin: 0 auto; }\n  .statline { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 26px; font-variant-numeric: tabular-nums; line-height: 1.1; }\n\n  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--s-4); padding-top: var(--s-7); }\n  .fcard { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-md); padding: var(--s-5); box-shadow: var(--e-1); }\n  .fcard b { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 15px; display: block; }\n  .fcard p { font-size: 13px; color: var(--text-3); padding-top: var(--s-2); }\n  .fcard .swver { font-family: var(--font-mono); font-size: 11px; color: var(--text-3); display: inline-block; padding-top: var(--s-3); }\n\n  .band { padding: var(--s-8) 0; }\n  .band h2 { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 24px; letter-spacing: -0.015em; text-align: center; }\n  .marqitem { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 15px; color: var(--text-3); white-space: nowrap; }\n  .marqitem .stop { color: var(--accent); }\n\n  footer { border-top: 1px solid var(--hairline); padding: var(--s-5); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--s-3); color: var(--text-3); font-size: 12.5px; position: relative; z-index: 1; }\n  .badge-line { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 13px; color: var(--text-2); }\n  .unit-sm { font-size: 13px; color: var(--text-3); font-family: var(--font-sans); font-weight: 500; }\n  ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }\n  .crumb a { display: inline-flex; align-items: center; gap: 8px; }\n  .crumb .vmark { width: 16px; height: 16px; flex: none; }\n  #themeflip { display: inline-grid; place-items: center; }\n  #themeflip .ticon { width: 16px; height: 16px; grid-area: 1 / 1; transition: transform var(--dur-3) var(--ease-back), opacity var(--dur-2) var(--ease-standard); }\n  #themeflip .tmoon { opacity: 0; transform: rotate(-90deg) scale(.5); }\n  [data-theme=\"light\"] #themeflip .tsun { opacity: 0; transform: rotate(90deg) scale(.5); }\n  [data-theme=\"light\"] #themeflip .tmoon { opacity: 1; transform: none; }\n  @media (prefers-reduced-motion: reduce) { #themeflip .ticon { transition: none; } }\n  .crumb .codelink { margin-left: auto; }\n</style>\n</head>\n<body>\n<div class=\"crumb\">\n  <a href=\"../index.html\"><svg class=\"vmark\" viewBox=\"0 0 768 775.92\" aria-hidden=\"true\"><defs><clipPath id=\"vmk-a\"><path d=\"M400 277h358v396.4H400z\"/></clipPath><clipPath id=\"vmk-b\"><path d=\"M10 97h550v576.4H10z\"/></clipPath><clipPath id=\"vmk-c\"><path d=\"M10 94.5h358V491H10z\"/></clipPath><clipPath id=\"vmk-d\"><path d=\"M208 94.5h550V671H208z\"/></clipPath></defs><g clip-path=\"url(#vmk-a)\"><path fill=\"currentColor\" opacity=\".55\" d=\"M 558.605469 278.128906 C 555.410156 277.984375 552.164062 277.90625 548.96875 277.90625 C 466.261719 277.90625 407.433594 327.675781 401.222656 333.144531 L 400.800781 333.59375 C 400.800781 333.59375 587.386719 406.570312 718.046875 673.386719 C 718.046875 673.386719 767.757812 550.011719 756.207031 509.574219 C 740.042969 453 663.917969 362.328125 584.683594 279.359375 L 558.605469 278.128906\"/></g><g clip-path=\"url(#vmk-b)\"><path fill=\"currentColor\" d=\"M 49.953125 673.386719 C 49.953125 673.386719 262.128906 253.59375 559.761719 253.59375 C 497.894531 190.457031 437.765625 134.679688 406.402344 106.136719 C 393.699219 94.574219 374.308594 94.574219 361.601562 106.136719 C 285.859375 175.0625 42.257812 402.917969 11.796875 509.574219 C 0.242188 550.011719 49.953125 673.386719 49.953125 673.386719\"/></g><g clip-path=\"url(#vmk-c)\"><path fill=\"currentColor\" opacity=\".55\" d=\"M 209.394531 489.785156 C 212.589844 489.929688 215.835938 490.007812 219.03125 490.007812 C 301.738281 490.007812 360.566406 440.238281 366.777344 434.765625 L 367.199219 434.316406 C 367.199219 434.316406 180.613281 361.34375 49.953125 94.523438 C 49.953125 94.523438 0.242188 217.902344 11.792969 258.335938 C 27.957031 314.914062 104.082031 405.585938 183.316406 488.554688 L 209.394531 489.785156\"/></g><g clip-path=\"url(#vmk-d)\"><path fill=\"currentColor\" d=\"M 718.046875 94.523438 C 718.046875 94.523438 505.871094 514.316406 208.238281 514.316406 C 270.105469 577.453125 330.234375 633.230469 361.597656 661.773438 C 374.300781 673.335938 393.691406 673.335938 406.398438 661.773438 C 482.140625 592.847656 725.742188 364.992188 756.203125 258.335938 C 767.757812 217.902344 718.046875 94.523438 718.046875 94.523438\"/></g></svg><span>VERSEVA Design<span class=\"stop\">.</span></span></a><span>examples</span><span>Launch</span>\n  <a class=\"btn btn-secondary sm codelink\" href=\"../code.html?f=examples/launch.html\">Code</a>\n  <button class=\"btn btn-ghost sm icon\" id=\"themeflip\" type=\"button\" aria-label=\"Switch to light theme\"><svg class=\"ticon tsun\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4.4\"/><path d=\"M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19\"/></svg><svg class=\"ticon tmoon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20.4 14.2A8.4 8.4 0 0 1 9.8 3.6a8.4 8.4 0 1 0 10.6 10.6Z\"/></svg></button>\n</div>\n<div class=\"glow\" aria-hidden=\"true\"></div>\n<main class=\"wrap\">\n\n  <section class=\"hero\">\n    <span class=\"kicker mo-rise\">Pulse 1.0 · out today</span>\n    <h1><span class=\"mo-lines\" id=\"heroline\">\n      <span><span>The number,</span></span>\n      <span><span>then the why<span class=\"stop\">.</span></span></span>\n    </span></h1>\n    <p class=\"sub mo-rise\">Pulse is the analytics console built on VERSEVA Design: denominator-first tiles, deltas colored by meaning, and not one gridline forest.</p>\n    <div class=\"cta\">\n      <span class=\"magnet\" data-magnet><a class=\"btn btn-primary lg beam\" href=\"pulse.html\">Open the console</a></span>\n      <span class=\"ctanote xswap\"><span class=\"xa\">npx verseva block add pulse</span><span class=\"xb\" aria-hidden=\"true\">one command, yours</span></span>\n    </div>\n  </section>\n\n  <section class=\"band\">\n    <div class=\"statrow launch mo-st\">\n      <div class=\"stat\">\n        <div class=\"statline\"><span class=\"ticker\" data-roll=\"112\"></span><span class=\"unit-sm\">/wk</span></div>\n        <div class=\"lbl\">Quotes priced</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"statline\"><span class=\"ticker\" data-roll=\"45\"></span><span class=\"unit-sm\">%</span></div>\n        <div class=\"lbl\">Win rate · 14 of 31</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"statline\"><span class=\"ticker\" data-roll=\"97\"></span><span class=\"unit-sm\">%</span></div>\n        <div class=\"lbl\">Lines with provenance</div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cards mo-st\" data-spot>\n    <div class=\"fcard spot\">\n      <b>Numbers on the marks</b>\n      <p>Every bar carries its count. Hover is a courtesy, never a requirement.</p>\n      <span class=\"swver xswap\"><span class=\"xa\">doctrine 01</span><span class=\"xb\" aria-hidden=\"true\">axes are a luxury</span></span>\n    </div>\n    <div class=\"fcard spot\">\n      <b>Deltas by meaning</b>\n      <p>A falling 5K time renders green. Direction is arithmetic; judgment is the color.</p>\n      <span class=\"swver xswap\"><span class=\"xa\">doctrine 02</span><span class=\"xb\" aria-hidden=\"true\">sign ≠ meaning</span></span>\n    </div>\n    <div class=\"fcard spot\">\n      <b>Attention that ends</b>\n      <p>The guide ring pulses twice, holds, and fades. Nothing on a Pulse screen nags.</p>\n      <span class=\"swver xswap\"><span class=\"xa\">doctrine 03</span><span class=\"xb\" aria-hidden=\"true\">pulse · hold · fade</span></span>\n    </div>\n  </section>\n\n  <section class=\"band\">\n    <div class=\"marq\" aria-hidden=\"true\">\n      <div class=\"mrow\"><span class=\"marqitem\">Denominator first<span class=\"stop\">.</span></span><span class=\"marqitem\">Two series max<span class=\"stop\">.</span></span><span class=\"marqitem\">Rings with a verdict<span class=\"stop\">.</span></span><span class=\"marqitem\">Takeaway captions<span class=\"stop\">.</span></span><span class=\"marqitem\">Provenance chips<span class=\"stop\">.</span></span></div>\n      <div class=\"mrow\"><span class=\"marqitem\">Denominator first<span class=\"stop\">.</span></span><span class=\"marqitem\">Two series max<span class=\"stop\">.</span></span><span class=\"marqitem\">Rings with a verdict<span class=\"stop\">.</span></span><span class=\"marqitem\">Takeaway captions<span class=\"stop\">.</span></span><span class=\"marqitem\">Provenance chips<span class=\"stop\">.</span></span></div>\n    </div>\n  </section>\n\n</main>\n<footer>\n  <span>Pulse · a VERSEVA Design example</span>\n  <span class=\"badge-line\">Built on VERSEVA Design<span class=\"stop\">.</span></span>\n</footer>\n<script>\n  document.documentElement.classList.add('js');\n  try { if (localStorage.getItem('verseva-theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}\n  // Theme wipe: the new theme sweeps out of the control as one View Transition.\n  const themeBtn = document.getElementById('themeflip');\n  const themeLabel = () => themeBtn.setAttribute('aria-label', document.documentElement.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');\n  themeLabel();\n  const flipTheme = () => {\n    const r = document.documentElement;\n    r.dataset.theme = r.dataset.theme === 'light' ? '' : 'light';\n    try { localStorage.setItem('verseva-theme', r.dataset.theme); } catch (e) {}\n    themeLabel();\n  };\n  themeBtn.addEventListener('click', (e) => {\n    const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (!document.startViewTransition || rm) return flipTheme();\n    const x = e.clientX || innerWidth / 2;\n    const y = e.clientY || 40;\n    const t = document.startViewTransition(flipTheme);\n    t.ready.then(() => {\n      const far = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));\n      document.documentElement.animate(\n        { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${far}px at ${x}px ${y}px)`] },\n        { duration: 480, easing: 'cubic-bezier(.16,1,.3,1)', pseudoElement: '::view-transition-new(root)' }\n      );\n    }).catch(() => {});\n  });\n\n  // Line reveal: closed state paints first, then the lines travel.\n  const hero = document.getElementById('heroline');\n  requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.add('in')));\n\n  // Spotlight group: the handler writes numbers; the contract owns the\n  // light. Rect reads coalesce to one batch per frame.\n  document.querySelectorAll('[data-spot]').forEach((group) => {\n    let frame = 0;\n    let last = null;\n    group.addEventListener('pointermove', (e) => {\n      last = { x: e.clientX, y: e.clientY };\n      if (frame) return;\n      frame = requestAnimationFrame(() => {\n        frame = 0;\n        group.querySelectorAll('.spot').forEach((card) => {\n          const r = card.getBoundingClientRect();\n          card.style.setProperty('--mx', (last.x - r.left) + 'px');\n          card.style.setProperty('--my', (last.y - r.top) + 'px');\n        });\n      });\n    });\n  });\n\n  // Magnetic CTA: follow at a third, settle on --ease-back. Home rect is\n  // cached at pointerenter so the follow never measures its own transform.\n  document.querySelectorAll('[data-magnet]').forEach((el) => {\n    let home = null;\n    el.addEventListener('pointerenter', () => {\n      const r = el.getBoundingClientRect();\n      home = { cx: r.left + r.width / 2, cy: r.top + r.height / 2 };\n    });\n    el.addEventListener('pointermove', (e) => {\n      if (!home || matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n      el.style.transition = 'none';\n      el.style.transform = `translate(${((e.clientX - home.cx) * 0.3).toFixed(1)}px, ${((e.clientY - home.cy) * 0.3).toFixed(1)}px)`;\n    });\n    el.addEventListener('pointerleave', () => {\n      home = null;\n      el.style.transition = 'transform var(--dur-4) var(--ease-back)';\n      el.style.transform = 'translate(0,0)';\n    });\n  });\n\n  // Rolling stats: build the columns at zero, roll to the value on first view.\n  const buildTicker = (host, str, at) => {\n    host.textContent = '';\n    for (const ch of str) {\n      if (!/\\d/.test(ch)) {\n        const s = document.createElement('span');\n        s.textContent = ch;\n        s.setAttribute('aria-hidden', 'true');\n        host.append(s);\n        continue;\n      }\n      const col = document.createElement('span');\n      col.className = 'td';\n      col.setAttribute('aria-hidden', 'true');\n      for (let d = 0; d <= 9; d++) { const i = document.createElement('i'); i.textContent = d; col.append(i); }\n      col.style.setProperty('--d', at ? ch : '0');\n      host.append(col);\n    }\n    const sr = document.createElement('span');\n    sr.className = 'sr-only';\n    sr.textContent = str;\n    host.append(sr);\n  };\n  const tickers = [...document.querySelectorAll('[data-roll]')];\n  tickers.forEach((t) => buildTicker(t, t.dataset.roll, false));\n  const roll = (t) => {\n    const digits = t.dataset.roll.replace(/\\D/g, '');\n    t.querySelectorAll('.td').forEach((col, i) => col.style.setProperty('--d', digits[i]));\n  };\n  if (typeof IntersectionObserver !== 'undefined') {\n    const io = new IntersectionObserver((es) => {\n      es.forEach((e) => { if (e.isIntersecting) { roll(e.target); io.unobserve(e.target); } });\n    }, { threshold: 0.4 });\n    tickers.forEach((t) => io.observe(t));\n  } else {\n    tickers.forEach(roll);\n  }\n</script>\n</body>\n</html>\n"
    }
  ]
}
