{
  "name": "launch",
  "kind": "block",
  "description": "Launch landing: the motion kit assembled — line reveal, spotlight, magnetic CTA, rolling stats, theme wipe",
  "deps": [],
  "files": [
    {
      "path": "launch.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VERSEVA Design · Example: Launch</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500..700&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap\">\n<link rel=\"stylesheet\" href=\"../../tokens.css?v=red1\">\n<link rel=\"stylesheet\" href=\"../../components.css?v=red1\">\n<style>\n  * { margin: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); font-size: 15px; line-height: 1.5; overflow-x: hidden; }\n  .crumb { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--hairline); font-size: 12.5px; color: var(--text-3); position: relative; z-index: 2; }\n  .crumb a { color: var(--text-2); text-decoration: none; font-family: var(--font-display); font-weight: var(--display-weight); }\n  .crumb .btn { margin-left: auto; }\n  .stop { color: var(--accent); }\n  .wrap { max-width: 66rem; margin: 0 auto; padding: 0 var(--s-5); position: relative; z-index: 1; }\n\n  /* The light arrives AFTER the words: a static blur, animated only on transform/opacity */\n  .glow { position: absolute; top: -220px; left: 50%; width: 720px; height: 480px; pointer-events: none; z-index: 0;\n    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent) 22%, transparent), transparent 65%);\n    filter: blur(80px); opacity: 0; transform: translate(-50%, -18%) scale(.7); }\n  @media (prefers-reduced-motion: no-preference) {\n    .glow { animation: lands 1.6s var(--ease-entrance) .7s forwards; }\n  }\n  @media (prefers-reduced-motion: reduce) { .glow { opacity: .55; transform: translate(-50%, 0) scale(1); } }\n  @keyframes lands { to { opacity: .55; transform: translate(-50%, 0) scale(1); } }\n\n  .hero { padding: calc(var(--s-8) + var(--s-6)) 0 var(--s-7); text-align: center; }\n  .kicker { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; color: var(--text-3); text-transform: uppercase; }\n  .hero h1 { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(40px, 7vw, 64px); letter-spacing: -0.025em; line-height: 1.12; padding-top: var(--s-4); }\n  .hero .sub { color: var(--text-2); max-width: 46ch; margin: 0 auto; padding-top: var(--s-4); }\n  .cta { display: flex; justify-content: center; align-items: center; gap: var(--s-4); padding-top: var(--s-6); }\n  .ctanote { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-3); }\n\n  .statrow.launch { max-width: 46rem; margin: 0 auto; }\n  .statline { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 26px; font-variant-numeric: tabular-nums; line-height: 1.1; }\n\n  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--s-4); padding-top: var(--s-7); }\n  .fcard { background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-md); padding: var(--s-5); box-shadow: var(--e-1); }\n  .fcard b { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 15px; display: block; }\n  .fcard p { font-size: 13px; color: var(--text-3); padding-top: var(--s-2); }\n  .fcard .swver { font-family: var(--font-mono); font-size: 11px; color: var(--text-3); display: inline-block; padding-top: var(--s-3); }\n\n  .band { padding: var(--s-8) 0; }\n  .band h2 { font-family: var(--font-display); font-weight: var(--heading-weight); font-size: 24px; letter-spacing: -0.015em; text-align: center; }\n  .marqitem { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 15px; color: var(--text-3); white-space: nowrap; }\n  .marqitem .stop { color: var(--accent); }\n\n  footer { border-top: 1px solid var(--hairline); padding: var(--s-5); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--s-3); color: var(--text-3); font-size: 12.5px; position: relative; z-index: 1; }\n  .badge-line { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 13px; color: var(--text-2); }\n  .unit-sm { font-size: 13px; color: var(--text-3); font-family: var(--font-sans); font-weight: 500; }\n  ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }\n</style>\n</head>\n<body>\n<div class=\"crumb\">\n  <a href=\"../index.html\">VERSEVA Design<span class=\"stop\">.</span></a><span>examples</span><span>Launch</span>\n  <button class=\"btn btn-ghost sm\" id=\"themeflip\" type=\"button\">Theme</button>\n</div>\n<div class=\"glow\" aria-hidden=\"true\"></div>\n<main class=\"wrap\">\n\n  <section class=\"hero\">\n    <span class=\"kicker mo-rise\">Pulse 1.0 · out today</span>\n    <h1><span class=\"mo-lines\" id=\"heroline\">\n      <span><span>The number,</span></span>\n      <span><span>then the why<span class=\"stop\">.</span></span></span>\n    </span></h1>\n    <p class=\"sub mo-rise\">Pulse is the analytics console built on VERSEVA Design: denominator-first tiles, deltas colored by meaning, and not one gridline forest.</p>\n    <div class=\"cta\">\n      <span class=\"magnet\" data-magnet><a class=\"btn btn-primary lg beam\" href=\"pulse.html\">Open the console</a></span>\n      <span class=\"ctanote xswap\"><span class=\"xa\">npx verseva block add pulse</span><span class=\"xb\" aria-hidden=\"true\">one command, yours</span></span>\n    </div>\n  </section>\n\n  <section class=\"band\">\n    <div class=\"statrow launch mo-st\">\n      <div class=\"stat\">\n        <div class=\"statline\"><span class=\"ticker\" data-roll=\"112\"></span><span class=\"unit-sm\">/wk</span></div>\n        <div class=\"lbl\">Quotes priced</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"statline\"><span class=\"ticker\" data-roll=\"45\"></span><span class=\"unit-sm\">%</span></div>\n        <div class=\"lbl\">Win rate · 14 of 31</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"statline\"><span class=\"ticker\" data-roll=\"97\"></span><span class=\"unit-sm\">%</span></div>\n        <div class=\"lbl\">Lines with provenance</div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cards mo-st\" data-spot>\n    <div class=\"fcard spot\">\n      <b>Numbers on the marks</b>\n      <p>Every bar carries its count. Hover is a courtesy, never a requirement.</p>\n      <span class=\"swver xswap\"><span class=\"xa\">doctrine 01</span><span class=\"xb\" aria-hidden=\"true\">axes are a luxury</span></span>\n    </div>\n    <div class=\"fcard spot\">\n      <b>Deltas by meaning</b>\n      <p>A falling 5K time renders green. Direction is arithmetic; judgment is the color.</p>\n      <span class=\"swver xswap\"><span class=\"xa\">doctrine 02</span><span class=\"xb\" aria-hidden=\"true\">sign ≠ meaning</span></span>\n    </div>\n    <div class=\"fcard spot\">\n      <b>Attention that ends</b>\n      <p>The guide ring pulses twice, holds, and fades. Nothing on a Pulse screen nags.</p>\n      <span class=\"swver xswap\"><span class=\"xa\">doctrine 03</span><span class=\"xb\" aria-hidden=\"true\">pulse · hold · fade</span></span>\n    </div>\n  </section>\n\n  <section class=\"band\">\n    <div class=\"marq\" aria-hidden=\"true\">\n      <div class=\"mrow\"><span class=\"marqitem\">Denominator first<span class=\"stop\">.</span></span><span class=\"marqitem\">Two series max<span class=\"stop\">.</span></span><span class=\"marqitem\">Rings with a verdict<span class=\"stop\">.</span></span><span class=\"marqitem\">Takeaway captions<span class=\"stop\">.</span></span><span class=\"marqitem\">Provenance chips<span class=\"stop\">.</span></span></div>\n      <div class=\"mrow\"><span class=\"marqitem\">Denominator first<span class=\"stop\">.</span></span><span class=\"marqitem\">Two series max<span class=\"stop\">.</span></span><span class=\"marqitem\">Rings with a verdict<span class=\"stop\">.</span></span><span class=\"marqitem\">Takeaway captions<span class=\"stop\">.</span></span><span class=\"marqitem\">Provenance chips<span class=\"stop\">.</span></span></div>\n    </div>\n  </section>\n\n</main>\n<footer>\n  <span>Pulse · a VERSEVA Design example</span>\n  <span class=\"badge-line\">Built on VERSEVA Design<span class=\"stop\">.</span></span>\n</footer>\n<script>\n  document.documentElement.classList.add('js');\n  // Theme wipe: the new theme sweeps out of the button as one View Transition.\n  const flipTheme = () => {\n    const r = document.documentElement;\n    r.dataset.theme = r.dataset.theme === 'light' ? '' : 'light';\n  };\n  document.getElementById('themeflip').addEventListener('click', (e) => {\n    const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (!document.startViewTransition || rm) return flipTheme();\n    const x = e.clientX || innerWidth / 2;\n    const y = e.clientY || 40;\n    const t = document.startViewTransition(flipTheme);\n    t.ready.then(() => {\n      const far = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));\n      document.documentElement.animate(\n        { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${far}px at ${x}px ${y}px)`] },\n        { duration: 480, easing: 'cubic-bezier(.16,1,.3,1)', pseudoElement: '::view-transition-new(root)' }\n      );\n    }).catch(() => {});\n  });\n\n  // Line reveal: closed state paints first, then the lines travel.\n  const hero = document.getElementById('heroline');\n  requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.add('in')));\n\n  // Spotlight group: the handler writes numbers; the contract owns the\n  // light. Rect reads coalesce to one batch per frame.\n  document.querySelectorAll('[data-spot]').forEach((group) => {\n    let frame = 0;\n    let last = null;\n    group.addEventListener('pointermove', (e) => {\n      last = { x: e.clientX, y: e.clientY };\n      if (frame) return;\n      frame = requestAnimationFrame(() => {\n        frame = 0;\n        group.querySelectorAll('.spot').forEach((card) => {\n          const r = card.getBoundingClientRect();\n          card.style.setProperty('--mx', (last.x - r.left) + 'px');\n          card.style.setProperty('--my', (last.y - r.top) + 'px');\n        });\n      });\n    });\n  });\n\n  // Magnetic CTA: follow at a third, settle on --ease-back. Home rect is\n  // cached at pointerenter so the follow never measures its own transform.\n  document.querySelectorAll('[data-magnet]').forEach((el) => {\n    let home = null;\n    el.addEventListener('pointerenter', () => {\n      const r = el.getBoundingClientRect();\n      home = { cx: r.left + r.width / 2, cy: r.top + r.height / 2 };\n    });\n    el.addEventListener('pointermove', (e) => {\n      if (!home || matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n      el.style.transition = 'none';\n      el.style.transform = `translate(${((e.clientX - home.cx) * 0.3).toFixed(1)}px, ${((e.clientY - home.cy) * 0.3).toFixed(1)}px)`;\n    });\n    el.addEventListener('pointerleave', () => {\n      home = null;\n      el.style.transition = 'transform var(--dur-4) var(--ease-back)';\n      el.style.transform = 'translate(0,0)';\n    });\n  });\n\n  // Rolling stats: build the columns at zero, roll to the value on first view.\n  const buildTicker = (host, str, at) => {\n    host.textContent = '';\n    for (const ch of str) {\n      if (!/\\d/.test(ch)) {\n        const s = document.createElement('span');\n        s.textContent = ch;\n        s.setAttribute('aria-hidden', 'true');\n        host.append(s);\n        continue;\n      }\n      const col = document.createElement('span');\n      col.className = 'td';\n      col.setAttribute('aria-hidden', 'true');\n      for (let d = 0; d <= 9; d++) { const i = document.createElement('i'); i.textContent = d; col.append(i); }\n      col.style.setProperty('--d', at ? ch : '0');\n      host.append(col);\n    }\n    const sr = document.createElement('span');\n    sr.className = 'sr-only';\n    sr.textContent = str;\n    host.append(sr);\n  };\n  const tickers = [...document.querySelectorAll('[data-roll]')];\n  tickers.forEach((t) => buildTicker(t, t.dataset.roll, false));\n  const roll = (t) => {\n    const digits = t.dataset.roll.replace(/\\D/g, '');\n    t.querySelectorAll('.td').forEach((col, i) => col.style.setProperty('--d', digits[i]));\n  };\n  if (typeof IntersectionObserver !== 'undefined') {\n    const io = new IntersectionObserver((es) => {\n      es.forEach((e) => { if (e.isIntersecting) { roll(e.target); io.unobserve(e.target); } });\n    }, { threshold: 0.4 });\n    tickers.forEach((t) => io.observe(t));\n  } else {\n    tickers.forEach(roll);\n  }\n</script>\n</body>\n</html>\n"
    }
  ]
}
