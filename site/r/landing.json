{
  "name": "landing",
  "kind": "block",
  "description": "Light marketing landing with a validating signup modal",
  "deps": [],
  "files": [
    {
      "path": "landing.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"light\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VERSEVA Design · Example: landing page</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500..700&family=Manrope:wght@400..700&family=JetBrains+Mono:wght@400..600&display=swap\">\n<link rel=\"stylesheet\" href=\"../../tokens.css?v=red1\">\n<link rel=\"stylesheet\" href=\"../../components.css?v=red1\">\n<style>\n  * { margin: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); font-size: 15px; line-height: 1.65; }\n  .crumb { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--hairline); font-size: 12.5px; color: var(--text-3); }\n  .crumb a { color: var(--text-2); text-decoration: none; font-family: var(--font-display); font-weight: var(--display-weight); }\n  .stop { color: var(--accent); }\n  .page { max-width: var(--container-content); margin: 0 auto; padding: 0 var(--s-5) var(--s-8); }\n  .nav { display: flex; align-items: center; gap: var(--s-5); padding: var(--s-4) 0; }\n  .nav .mark { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 16px; }\n  .nav nav { flex: 1; display: flex; gap: var(--s-4); }\n  .nav nav a { font-size: 13.5px; color: var(--text-2); text-decoration: none; }\n  .hero { padding: var(--s-9) 0 var(--s-7); max-width: 46rem; }\n  .hero h1 { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(38px, 6vw, 60px); letter-spacing: -0.025em; line-height: 1.05; }\n  .hero p { color: var(--text-2); font-size: 17px; max-width: 52ch; padding-top: var(--s-4); }\n  .hero .cta { display: flex; gap: var(--s-3); padding-top: var(--s-5); }\n  .proof { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--s-4); padding-top: var(--s-6); }\n  .proof .card .bd b { color: var(--text-1); font-weight: 600; }\n  .band { display: flex; gap: var(--s-6); flex-wrap: wrap; align-items: center; padding: var(--s-7) 0; }\n  .band .stat { flex: 1; min-width: 160px; }\n  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--s-3); padding-top: var(--s-7); color: var(--text-3); font-size: 12.5px; }\n  .badge-line { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 13px; color: var(--text-2); }\n</style>\n</head>\n<body>\n<div class=\"crumb\"><a href=\"../index.html\">VERSEVA Design<span class=\"stop\">.</span></a><span>examples</span><span>landing page</span></div>\n<div class=\"page\">\n  <header class=\"nav\">\n    <span class=\"mark\">Ledgerline<span class=\"stop\">.</span></span>\n    <nav><a href=\"#how\">How it works</a><a href=\"#proof\">Proof</a><a href=\"#pricing\">Pricing</a></nav>\n    <button class=\"btn btn-ghost sm\" type=\"button\">Sign in</button>\n    <button class=\"btn btn-primary sm\" type=\"button\" data-open=\"signup\">Start free</button>\n  </header>\n  <section class=\"hero\">\n    <h1>Monthly close in five days<span class=\"stop\">.</span></h1>\n    <p>Ledgerline reconciles every account, flags what a human must see, and files the rest. Built for restaurant groups tired of closing in week three.</p>\n    <div class=\"cta\">\n      <button class=\"btn btn-primary lg\" type=\"button\" data-open=\"signup\">Start free</button>\n      <button class=\"btn btn-secondary lg\" type=\"button\" id=\"watchbtn\">Watch the close</button>\n    </div>\n  </section>\n  <section class=\"proof\" id=\"proof\">\n    <div class=\"card\"><div class=\"hd\"><h4>11 locations</h4></div><div class=\"bd\"><b>Harbor Group</b> closed March in 4 days, 6 hours of bookkeeper time total.</div></div>\n    <div class=\"card\"><div class=\"hd\"><h4>98.4% auto-matched</h4></div><div class=\"bd\"><b>Northline</b> reviews forty transactions a month. The rest file themselves.</div></div>\n    <div class=\"card\"><div class=\"hd\"><h4>Zero restatements</h4></div><div class=\"bd\"><b>Crestpoint</b> has run eleven clean audits on Ledgerline books.</div></div>\n  </section>\n  <section class=\"band\">\n    <div class=\"stat\"><div class=\"num\">5<i>days</i></div><div class=\"lbl\">Median close</div></div>\n    <div class=\"stat\"><div class=\"num\">312</div><div class=\"lbl\">Locations closing monthly</div></div>\n    <div class=\"stat\"><div class=\"num\">4.9</div><div class=\"lbl\">Controller rating</div></div>\n  </section>\n  <footer>\n    <span>Ledgerline is a fictional product; this page is a VERSEVA Design example.</span>\n    <span class=\"badge-line\">Built on VERSEVA Design<span class=\"stop\">.</span></span>\n  </footer>\n</div>\n\n<div class=\"ovl\" id=\"signup-ovl\">\n  <div class=\"modal\">\n    <div class=\"bd\">\n      <h4>Start free</h4>\n      <p>Thirty days, every location, no card. The fictional onboarding takes four minutes.</p>\n      <div class=\"field\" id=\"email-field\">\n        <label for=\"email\">Work email</label>\n        <input id=\"email\" type=\"email\" placeholder=\"you@restaurantgroup.com\">\n        <div class=\"help\" id=\"email-help\">We only use this to create the workspace.</div>\n      </div>\n    </div>\n    <div class=\"ft\">\n      <button class=\"btn btn-ghost\" type=\"button\" id=\"signup-cancel\">Cancel</button>\n      <button class=\"btn btn-primary\" type=\"button\" id=\"signup-go\">Create workspace</button>\n    </div>\n  </div>\n</div>\n<div id=\"toastwrap\"></div>\n<style>\n  .ovl { position: fixed; inset: 0; background: color-mix(in srgb, var(--text-1) 18%, transparent); display: none; align-items: center; justify-content: center; z-index: 9; padding: var(--s-5); }\n  .ovl.open { display: flex; }\n  #toastwrap .toast { position: fixed; right: var(--s-5); bottom: var(--s-5); z-index: 10; }\n</style>\n<script>\n  const ovl = document.getElementById('signup-ovl');\n  const emailField = document.getElementById('email-field');\n  const email = document.getElementById('email');\n  const help = document.getElementById('email-help');\n  document.querySelectorAll('[data-open=\"signup\"]').forEach((b) => b.addEventListener('click', () => {\n    ovl.classList.add('open');\n    email.focus();\n  }));\n  const close = () => {\n    ovl.classList.remove('open');\n    emailField.classList.remove('error');\n    help.textContent = 'We only use this to create the workspace.';\n    email.value = '';\n  };\n  document.getElementById('signup-cancel').addEventListener('click', close);\n  ovl.addEventListener('click', (e) => { if (e.target === ovl) close(); });\n  document.getElementById('signup-go').addEventListener('click', () => {\n    if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email.value.trim())) {\n      emailField.classList.add('error');\n      help.textContent = 'Enter a work email first.';\n      email.focus();\n      return;\n    }\n    close();\n    const wrap = document.getElementById('toastwrap');\n    wrap.replaceChildren();\n    const toast = document.createElement('div');\n    toast.className = 'toast ok';\n    toast.innerHTML = '<span class=\"dot\"></span>Workspace created. Check your inbox (fictionally).';\n    wrap.append(toast);\n    setTimeout(() => toast.remove(), 2600);\n  });\n  document.getElementById('watchbtn').addEventListener('click', () => {\n    document.getElementById('proof').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });\n  });\n</script>\n</body>\n</html>\n"
    }
  ]
}
